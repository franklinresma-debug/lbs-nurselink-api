[Unit]
Description=NurseLink restricted production backup
After=network.target mysql.service
Requires=mysql.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/lbs-nurselink-backup

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=full
ReadWritePaths=/root/lbs-nurselink-automated-backups /run/lbs-lbs-nurselink-backup
RuntimeDirectory=lbs-nurselink-backup
RuntimeDirectoryMode=0700
