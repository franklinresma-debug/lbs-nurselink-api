[Unit]
Description=Notify NurseLink operations when the backup service fails
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/var/www/lbs-nurselink-api
ExecStart=/usr/bin/php artisan nurselink:monitor-production --incident=backup-service-failed --no-interaction

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=full
ReadWritePaths=/var/www/lbs-nurselink-api/storage /var/www/lbs-nurselink-api/bootstrap/cache
